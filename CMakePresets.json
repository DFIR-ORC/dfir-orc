        },
        {
            "name": "dfir-orc-arm64",
            "inherits": "dfir-orc-base",
            "binaryDir": "${sourceDir}/build/dfir-orc-arm64",
            "architecture": { "value": "arm64", "strategy": "set" },
            "cacheVariables": {
