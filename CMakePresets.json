            }
        },
        {
            "name": "dfir-orc-x64-ninja",
            "displayName": "Ninja Multi-Config (x64)",
            "description": "Ninja build of the x64 target. Requires a Visual Studio x64 developer environment: both 'architecture' and 'toolset' use the 'external' strategy, so CMake relies on the environment instead of setting them (Ninja rejects '-A'/'-T'). The XP presets cannot use Ninja: CMakeLists.txt keys CMAKE_SYSTEM_VERSION and the C++ standard off CMAKE_GENERATOR_TOOLSET, which 'external' leaves unset.",
            "inherits": "dfir-orc-x64",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/build/dfir-orc-x64-ninja",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "v143",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "dfir-orc-x64-clangd",
            "displayName": "clangd compile_commands (Ninja, x64)",
            "description": "Standalone Ninja configure that emits compile_commands.json for the clangd LSP.",
            "inherits": "dfir-orc-x64",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/dfir-orc-x64-clangd",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "toolset": {
                "value": "v143",
                "strategy": "external"
            },
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "capsule-base",
