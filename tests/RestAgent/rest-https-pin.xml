<?xml version="1.0" encoding="utf-8"?>
<!--
  REST upload over HTTPS to a SELF-SIGNED server, validated by certificate PINNING.
  The secure way to use a self-signed endpoint: no insecure flag needed. The agent lets
  the untrusted cert finish the handshake, then verifies its public key (SPKI) against
  server_cert_pin before sending the body. Survives cert renewal with the same key.
  Put the cert's Base64 DER (one line, no BEGIN/END) into server_cert_pin below.
  See README.md for the test-server command, the openssl one-liner, and the port caveat.
-->
<dfir-orc>
    <upload method="REST" server="https://127.0.0.1:8443"
            https_security="tls1.3, tls1.2" operation="move"
            server_cert_pin="REPLACE_WITH_BASE64_DER_OF_server.crt">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}" chunk_size="1048576">
            <header>Content-Range: bytes {upload.range_start}-{upload.range_end}/{upload.total_size}</header>
        </rest>
    </upload>
</dfir-orc>
