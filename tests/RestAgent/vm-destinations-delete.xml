<?xml version="1.0" encoding="utf-8"?>
<!-- VM live test: delete_when_done with every required destination confirming. Both are live and
     required, so once both have the archive the local copy is no longer needed and must be gone.
     Scored on the pair "the sink has it" and "the host no longer does" (DeletesLocal): the local
     archive is deleted, so there is nothing left to hash against. -->
<dfir-orc>
    <uploads delete_when_done="yes">
        <destination name="a">
            <upload method="REST" server="%ORC_UPLOAD_SERVER%"
                    https_security="tls1.3, tls1.2" operation="copy"
                    server_cert_pin="">
                <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
            </upload>
        </destination>
        <destination name="b">
            <upload method="REST" server="%ORC_UPLOAD_SERVER2%"
                    https_security="tls1.3, tls1.2" operation="copy"
                    server_cert_pin="">
                <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
            </upload>
        </destination>
    </uploads>
</dfir-orc>

