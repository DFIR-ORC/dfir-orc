<?xml version="1.0" encoding="utf-8"?>
<!-- VM live test: the two destinations receive DIFFERENT sets. 'a' takes everything; 'b' excludes the
     archive and so receives only the run's own files (the log), because include/exclude select
     collected data and never the collection's own bookkeeping.

     Scored on the two sinks DIFFERING (ReceivedDir2Differs): identical sinks would mean the filters
     selected nothing and the scenario tested nothing. -->
<dfir-orc>
    <uploads>
        <destination name="a">
            <upload method="REST" server="%ORC_UPLOAD_SERVER%"
                    https_security="tls1.3, tls1.2" operation="copy"
                    server_cert_pin="">
                <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
            </upload>
        </destination>
        <destination name="b" exclude="*.7z">
            <upload method="REST" server="%ORC_UPLOAD_SERVER2%"
                    https_security="tls1.3, tls1.2" operation="copy"
                    server_cert_pin="">
                <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
            </upload>
        </destination>
    </uploads>
</dfir-orc>

