<?xml version="1.0" encoding="utf-8"?>
<!-- VM live test: two destinations, both live, each writing to its OWN sink directory (8443 and 8461).
     The assertion is that BOTH received a byte-exact copy: destinations are independent, not a
     fallback chain, so neither one succeeding may stop the other from being served.

     Both use operation="copy". With more than one destination, operation="move" is refused when the
     configuration is read, which the unit tests cover rather than this rig. -->
<dfir-orc>
    <uploads>
        <destination name="a">
            <upload method="REST" server="%ORC_UPLOAD_SERVER%"
                    https_security="tls1.3, tls1.2" operation="copy"
                    server_cert_pin="">
                <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
            </upload>
        </destination>
        <destination name="b">
            <upload method="REST" server="%ORC_UPLOAD_SERVER2%"
                    https_security="tls1.3, tls1.2" operation="copy"
                    server_cert_pin="">
                <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
            </upload>
        </destination>
    </uploads>
</dfir-orc>

