<?xml version="1.0" encoding="utf-8"?>
<!-- VM live test: the PRIMARY entry excludes the very archive, and its destination is dead. The
     fallback asks for everything, so it must receive the archive: what the run produced is recorded
     whatever the first entry made of it, or no later destination could ever be offered the file.

     The mirror of vm-fallback-filtered.xml, which checks the other direction - a fallback that
     excludes the archive receives nothing. -->
<dfir-orc>
    <upload method="REST" server="http://127.0.0.1:9" operation="copy" insecure="true" exclude="*.7z">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
    </upload>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
    </upload>
</dfir-orc>
