<?xml version="1.0" encoding="utf-8"?>
<!-- VM live test: a two-entry fallback list whose entries deliberately DISAGREE on 'operation'. The
     primary points at a dead port on the ORC host itself, so every request fails with a connection
     error and attempt #1 must be reported as failed; the fallback is the live sink, where the archive
     lands on attempt #2.

     Two things are under test at once:

     - that a failed attempt is noticed at all. If the launcher reads its outcome from a notification
       that has not been delivered yet, attempt #1 looks successful, the loop breaks, and the sink
       receives nothing.
     - that the fallback runs with ITS OWN operation. Requests are recorded from the primary as each
       file is produced, so replaying them as recorded would delete the local archive under the
       primary's operation="move" although this entry says copy. A byte-exact verdict requires the
       local archive to have survived.

     The filters are exercised by vm-fallback-filtered.xml instead. -->
<dfir-orc>
    <upload method="REST" server="http://127.0.0.1:9" operation="move" insecure="true">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
    </upload>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
    </upload>
</dfir-orc>
