<?xml version="1.0" encoding="utf-8"?>
<!--
  VM live test: the negative control for vm-form-login.xml. Same mock sink (port 8460, see
  start_sinks.sh's share_login mode) and the same share token, but the GET/POST login steps are
  removed - only the PUT remains, with no session cookie ever obtained. The mode is named in prose
  rather than by its flag for the reason vm-form-login.xml's header gives: a double hyphen inside an
  XML comment makes XmlLite reject the file.

  The write under /public.php/dav/files/<token>/... has no HTTP credential of its own - the session
  cookie IS the only authentication - so this PUT must be refused with 401. A Negative scenario: no
  archive may reach the sink, and the run.log must name the 401 specifically (ExpectLog), so a refusal
  for an unrelated reason (a bad path, a TLS failure) does not pass this scenario by accident.

  This is what proves vm-form-login.xml's PASS means the dialog actually authenticated, rather than the
  sink accepting any PUT under that path regardless of the login.
-->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">

        <rest http_method="PUT"
              path="/public.php/dav/files/orcvmshare1/{upload.filename}"
              body="{upload.local_path}"/>

    </upload>
</dfir-orc>
