<?xml version="1.0" encoding="utf-8"?>
<!-- VM live test: plain HTTP whole-file upload to the Debian sink (192.168.254.23:8080). -->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            operation="copy" insecure="true">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"
              http_query="?start={upload.range_start}&amp;total={upload.total_size}"/>
    </upload>
</dfir-orc>
