<?xml version="1.0" encoding="utf-8"?>
<!-- VM live test (NEGATIVE): HTTPS with a WRONG pin - a throwaway self-signed certificate ('CN=wrong-pin.invalid',
     an RFC 2606 reserved name) whose private key exists nowhere, so no sink can ever serve it. It is deliberately
     NOT the certificate every other vm-https-*.xml pins, which is what makes this the negative test, and
     make-local-fixtures.ps1 leaves it alone for the same reason.
     Expect: pin mismatch -> "matches no configured 'server_cert_pin'", body never sent, upload fails. -->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"
              http_query="?start={upload.range_start}&amp;total={upload.total_size}"/>
    </upload>
</dfir-orc>
