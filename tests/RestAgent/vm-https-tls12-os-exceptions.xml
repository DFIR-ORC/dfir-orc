<?xml version="1.0" encoding="utf-8"?>
<!-- VM live test: "tls1.2" with TLS 1.0/1.1 exceptions for XP and Seven, allowed by insecure="true", against
     the TLS-1.1-capped sink (port 8445). On any other Windows the exceptions do not apply and the floor stays
     TLS 1.2, so the upload must be refused even though insecure permits the lower versions. -->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.2, tls1.0[xp], tls1.1[seven]" insecure="true" operation="copy"
            server_cert_pin="">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"
              http_query="?start={upload.range_start}&amp;total={upload.total_size}"/>
    </upload>
</dfir-orc>
