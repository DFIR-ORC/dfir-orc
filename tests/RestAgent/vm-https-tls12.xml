<?xml version="1.0" encoding="utf-8"?>
<!-- Control for vm-https-tls13.xml: same TLS-1.2-capped sink (port 8444), but the client floor allows
     TLS 1.2 (https_security="tls1.3, tls1.2"). The handshake negotiates TLS 1.2 and the upload SUCCEEDS,
     proving the vm-https-tls13.xml failure is specifically the version floor, not pinning or reachability. -->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"
              http_query="?start={upload.range_start}&amp;total={upload.total_size}"/>
    </upload>
</dfir-orc>
