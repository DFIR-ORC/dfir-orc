<?xml version="1.0" encoding="utf-8"?>
<!--
  VM live test: the vm-nextcloud-chunked.xml dialog with a chunk size small enough that this rig's
  archives actually split. It exists because the realistic 10 MiB of that fixture makes every
  archive the bench produces a SINGLE chunk (the smallest is 891 bytes), which leaves the part worth
  testing - how Nextcloud reassembles several chunks, and in what order - never exercised.

  chunk_size="64" is deliberately absurd, and is the whole point: do NOT copy this value into a real
  configuration, copy vm-nextcloud-chunked.xml. At 64 bytes a ~900 byte archive becomes 14 chunks
  named 0, 64, 128, ... 832, whose LEXICOGRAPHIC order ("128" before "64") differs from their numeric
  one. So the byte-exact comparison at the end of the scenario only holds if Nextcloud sorted the
  chunk names numerically, which is the property the offset-named chunks of this engine depend on.
-->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            user="orc" password="orc-test-not-a-secret" authscheme="Basic"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">
        <rest http_method="MKCOL" path="/remote.php/dav/files/orc/orc-upload/" accept_status="405"/>
        <rest http_method="MKCOL" path="/remote.php/dav/uploads/orc/{upload.random:hex:16}"/>
        <rest http_method="PUT" path="/remote.php/dav/uploads/orc/{upload.random:hex:16}/{upload.range_start}"
              body="{upload.local_path}" chunk_size="64"/>
        <rest http_method="MOVE" path="/remote.php/dav/uploads/orc/{upload.random:hex:16}/.file">
            <header>Destination: /remote.php/dav/files/orc/orc-upload/{upload.filename}</header>
        </rest>
    </upload>
</dfir-orc>
