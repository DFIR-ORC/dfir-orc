<?xml version="1.0" encoding="utf-8"?>
<!--
  VM live test: upload to a Nextcloud instance over its WebDAV endpoint, whole file in one PUT.

  The dialog is the generic WebDAV one (see rest-webdav.xml) pointed at Nextcloud's per-account DAV
  root, /remote.php/dav/files/<account>/: MKCOL the destination collection, then PUT the body into it.
  MKCOL carries accept_status="405" because Nextcloud answers a MKCOL on an existing collection with
  405, which is the normal state from the second run on.

  Credentials are the account vm/setup_nextcloud.sh creates. Basic is preemptive (no 401 round-trip),
  and the password is embedded in clear, as it would be in a real deployment - so use a scoped,
  revocable account, or a Nextcloud app password, never an admin credential.
-->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            user="orc" password="orc-test-not-a-secret" authscheme="Basic"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">
        <rest http_method="MKCOL" path="/remote.php/dav/files/orc/orc-upload/" accept_status="405"/>
        <rest http_method="PUT" path="/remote.php/dav/files/orc/orc-upload/{upload.filename}"
              body="{upload.local_path}"/>
    </upload>
</dfir-orc>
