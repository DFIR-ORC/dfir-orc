<?xml version="1.0" encoding="utf-8"?>
<!-- VM live test: the server already holds a copy at least as large as the file being uploaded, so the
     HEAD probe captures a size that clamps the resume offset to the end and the body step sends nothing.
     operation="move" makes the stake visible: the run must NOT delete the local archive on the strength
     of a completeness only the server asserted, and must report the upload as incomplete.

     Needs the sink seeded with a file at the target name (run-vmtest.ps1 does it via the scenario's
     Seed command); against an empty sink the HEAD returns 404, the offset defaults to 0 and the whole
     file is uploaded normally. -->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="move"
            server_cert_pin="">
        <rest http_method="HEAD" path="/up/{upload.filename}" accept_status="404">
            <response header="content-length" name="remote_size" default="0"/>
        </rest>
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"
              offset="{remote_size}"
              http_query="?start={upload.range_start}&amp;total={upload.total_size}"/>
    </upload>
</dfir-orc>
