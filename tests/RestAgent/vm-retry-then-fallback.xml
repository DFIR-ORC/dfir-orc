<?xml version="1.0" encoding="utf-8"?>
<!-- VM live test: an entry's retries are exhausted BEFORE the next entry is tried, not round-robin.

     Entry #1 points at a dead port on the ORC host and asks for retry="1" retry_delay="1", so it is
     attempted twice and fails twice; entry #2 is the live sink and takes the archive afterwards.

     Two things are under test, and both are needed:

     - the ordering. A byte-exact archive at the sink only says the fallback ran; it is the ExpectLog
       ("failed after 2 attempt(s)") that says entry #1 really retried before the loop moved on. An
       implementation that fell through to entry #2 after the first failure would still deliver the
       archive and would still pass on bytes alone.
     - that the retries do not consume the fallback. Exhausting an entry must leave the list intact.

     operation="copy" on both, unlike vm-fallback.xml: 'move' is exercised there, and here it would only
     blur what is being measured. -->
<dfir-orc>
    <upload method="REST" server="http://127.0.0.1:9" operation="copy" insecure="true"
            retry="1" retry_delay="1">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
    </upload>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">
        <rest http_method="PUT" path="/up/{upload.filename}" body="{upload.local_path}"/>
    </upload>
</dfir-orc>
