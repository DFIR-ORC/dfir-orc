<?xml version="1.0" encoding="utf-8"?>
<!--
  VM live test: authenticated upload to a SeaweedFS (S3) bucket, whole object in one PUT, using AWS SigV4.

  Byte for byte the dialog of vm-minio-sigv4.xml and vm-rustfs-sigv4.xml, pointed at a THIRD S3
  implementation. MinIO and RustFS are close relatives - same bucket model, same object layout, the same
  admin API - so a signature both accept could still be a dialect they share. SeaweedFS is a distributed
  object store with an S3 gateway in front of a filer, with its own identity file and its own on-disk
  representation; a signature all three accept is standard SigV4. setup_seaweedfs.sh provisions the same
  separate orc-signed bucket and orcupload identity, able to write orc-signed/orc-upload/ and nothing
  else. The anonymous orc bucket vm-seaweedfs.xml uses is untouched.

  access_key/secret_key are placeholders here on purpose, for the same reason as vm-minio-sigv4.xml:
  those two attributes are NOT environment-expanded (see tests/RestAgent/README.md, "AWS SigV4"), so a
  committed real key would sit in the repository in the clear. make-local-fixtures.ps1 copies this file
  into the git-ignored local/ directory unchanged; replace the two placeholders there with the access
  key and secret setup_seaweedfs.sh printed when it created the orcupload identity.
-->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="copy"
            authscheme="AWSv4" access_key="REPLACE_WITH_YOUR_ACCESS_KEY" secret_key="REPLACE_WITH_YOUR_SECRET_KEY"
            aws_region="us-east-1"
            server_cert_pin="">
        <rest http_method="PUT" path="/orc-signed/orc-upload/{upload.filename}" body="{upload.local_path}"/>
    </upload>
</dfir-orc>
