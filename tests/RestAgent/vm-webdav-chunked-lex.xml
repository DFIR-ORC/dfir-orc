<?xml version="1.0" encoding="utf-8"?>
<!--
  VM live test, NEGATIVE: exactly the vm-webdav-chunked.xml upload, sent to the sink on the port that
  assembles chunks in LEXICOGRAPHIC order instead of numeric (the sink's chunk-sort option).

  The archive still arrives - nothing is refused, every request returns 2xx - but its 14 offset-named
  chunks are concatenated as "0, 128, 192, ... 64, 640, ...", so what lands on the sink does not match
  what was sent. The scenario passes only when the sha256 DIFFERS.

  Two things it proves that the positive scenario alone cannot: that the byte-exact comparison every
  other scenario is scored on actually discriminates, rather than passing on anything that arrives;
  and that the numeric ordering vm-webdav-chunked.xml (and Nextcloud) rely on is load-bearing, not a
  coincidence the offset naming would survive without.
-->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">
        <rest http_method="MKCOL" path="/up/uploads/" accept_status="405"/>
        <rest http_method="MKCOL" path="/up/uploads/{upload.random:hex:16}"/>
        <rest http_method="PUT" path="/up/uploads/{upload.random:hex:16}/{upload.range_start}"
              body="{upload.local_path}" chunk_size="64"/>
        <rest http_method="MOVE" path="/up/uploads/{upload.random:hex:16}/.file">
            <header>Destination: /up/{upload.filename}</header>
        </rest>
    </upload>
</dfir-orc>
