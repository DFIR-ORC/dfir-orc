<?xml version="1.0" encoding="utf-8"?>
<!--
  VM live test: the chunked WebDAV dialog against the python sink - one request per chunk, each to its
  OWN path named by the chunk's byte offset, then a MOVE of the "<dir>/.file" pseudo-entry that makes
  the server concatenate them. This is the engine half of vm-nextcloud-chunked.xml, verified without
  Nextcloud; that fixture only confirms a real Nextcloud implements the same convention.

  Mechanisms no other sink scenario reaches:
    - {upload.range_start} in the PATH, so each chunk lands on a different URL. Everywhere else the
      offset travels in http_query or a Content-Range header and all chunks share one path.
    - {upload.random:...} having to resolve IDENTICALLY across four steps. A fresh value per step
      would scatter the chunks over four directories and leave the MOVE nothing to assemble.
    - server-side assembly order. chunk_size="64" is deliberately tiny so this rig's ~900 byte archive
      becomes 14 chunks whose lexicographic order ("128" before "64") differs from their numeric one,
      which is what makes the byte-exact verdict an assertion about ordering. The sink sorts numerically,
      as Nextcloud does; vm-webdav-chunked-lex.xml is the same upload against a sink that does not.
-->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">
        <rest http_method="MKCOL" path="/up/uploads/" accept_status="405"/>
        <rest http_method="MKCOL" path="/up/uploads/{upload.random:hex:16}"/>
        <rest http_method="PUT" path="/up/uploads/{upload.random:hex:16}/{upload.range_start}"
              body="{upload.local_path}" chunk_size="64"/>
        <rest http_method="MOVE" path="/up/uploads/{upload.random:hex:16}/.file">
            <header>Destination: /up/{upload.filename}</header>
        </rest>
    </upload>
</dfir-orc>
