<?xml version="1.0" encoding="utf-8"?>
<!--
  VM live test: the generic WebDAV dialog against the python sink - MKCOL, a staged PUT, and a MOVE
  onto the final name. Nothing here is Nextcloud-specific; vm-nextcloud.xml only confirms that a real
  Nextcloud accepts the same shape.

  Three mechanisms no other sink scenario reaches:
    - MKCOL with accept_status="405", the code a WebDAV server returns for a collection that already
      exists, which is the normal state from the second run on;
    - a control step AFTER the body step (every other fixture's body step is the last one);
    - MOVE, whose target is named in a per-step <header> rather than in the request path.

  Staging the body under a .part name and moving it into place is also how an operator keeps a partial
  upload from being mistaken for a finished one: the final name appears only once the body is complete.
-->
<dfir-orc>
    <upload method="REST" server="%ORC_UPLOAD_SERVER%"
            https_security="tls1.3, tls1.2" operation="copy"
            server_cert_pin="">
        <rest http_method="MKCOL" path="/up/staging/" accept_status="405"/>
        <rest http_method="PUT" path="/up/staging/{upload.filename}.part" body="{upload.local_path}"/>
        <rest http_method="MOVE" path="/up/staging/{upload.filename}.part">
            <header>Destination: /up/{upload.filename}</header>
        </rest>
    </upload>
</dfir-orc>
